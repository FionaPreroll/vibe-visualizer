# Cloudflare (static assets of Workers, or Pages): cross-origin isolation, required for
# SharedArrayBuffer.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Vite names these files by their content, so a new build never changes one of them.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
