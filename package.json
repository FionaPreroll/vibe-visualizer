{
  "name": "vibe-visualizer",
  "private": true,
  "version": "0.0.0",
  "description": "Audio-reactive music visualizer that renders HD videos in the browser",
  "bugs": {
    "email": "fipreroll+app@gmail.com"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:firefox": "playwright test --project firefox",
    "test:soak": "playwright test -c playwright.soak.config.ts",
    "eval:drums": "vitest run tests/eval --silent=false",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@fibestation/dj-controllers": "workspace:*",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@mediabunny/aac-encoder": "^1.60.0",
    "fft.js": "^4.0.4",
    "mediabunny": "^1.60.0",
    "signalsmith-stretch": "^1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
